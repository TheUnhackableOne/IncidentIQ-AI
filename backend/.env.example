# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/incidentiq
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Reranking Configuration
RERAN_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERAN_TOP_K=5

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=128
RETRIEVAL_TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=0.5

# Agent Configuration
MAX_INVESTIGATION_STEPS=20
MAX_TOOL_RETRIES=3
INVESTIGATION_TIMEOUT_SECONDS=300

# Evaluation Configuration
EVALUATION_SAMPLE_SIZE=100
EVALUATION_BATCH_SIZE=10
